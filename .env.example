# 环境变量示例
# 复制此文件为 .env 并填入实际值

# API配置 - 必须包含协议前缀 https://
VITE_API_BASE_URL=https://your-project.vercel.app

# 微信支付配置
VITE_WECHAT_APPID=your-wechat-appid
VITE_WECHAT_MCHID=your-wechat-mchid
VITE_PAYMENT_NOTIFY_URL=https://your-project.vercel.app/api/payment/wechat-callback

# 支付宝配置
VITE_ALIPAY_APP_ID=your-alipay-app-id

# 应用标题
VITE_APP_TITLE=木墨文坊

# 调试模式
VITE_DEBUG=true

# AI 服务配置（可选）
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
VITE_OLLAMA_BASE_URL=http://localhost:11434

# MongoDB 数据库配置
# 注意：在Vercel/Netlify等平台上，应使用环境变量设置而不是此文件
# 连接字符串格式：mongodb+srv://<username>:<password>@<cluster>/<database-name>?<options>
MONGODB_URI=mongodb://localhost:27017/mumo-ai-writer
MONGODB_DB_NAME=mumo-ai-writer