{
  "version": 2,
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/auth/register",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/auth/verify-token",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/users",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/users/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/novels",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/novels/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/chapters",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/chapters/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/outlines",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/outlines/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/characters",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/characters/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/locations",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/locations/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/world-settings",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/world-settings/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "/assets/.*\\.js$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "application/javascript"
      }
    },
    {
      "src": "/assets/.*\\.css$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "text/css"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "buildCommand": "pnpm build:vercel",
  "installCommand": "pnpm install",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@3.0.7"
    }
  }
}